# Fait échouer `npm install` sur un Node hors de engines.node, au lieu de laisser
# l'incompatibilité surgir plus tard sous forme d'erreur cryptique de Nuxt.
# Les scripts npm (`npm run dev`, …) ne sont pas couverts par ce réglage :
# c'est le rôle de scripts/check-node.mjs, branché sur predev/prebuild/pretest.
engine-strict=true
